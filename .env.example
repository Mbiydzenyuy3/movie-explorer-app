# TMDB — SERVER ONLY.
# Deliberately has no VITE_ prefix: Vite inlines every VITE_* variable into the
# browser bundle. Renaming this to VITE_API_KEY puts the key into shipped
# JavaScript, which is the exact bug the /api/tmdb proxy exists to prevent.
# On Vercel, set this as a project environment variable.
TMDB_API_KEY=

# Public by design — safe in the client bundle.
VITE_BASE_IMG_PATH=https://image.tmdb.org/t/p/original

# Supabase. The anon key is publishable; Row Level Security is what protects
# the data, NOT the secrecy of this key. Before deploying, run the preflight
# query (supabase/queries.sql section 0b) and check every row reads OK.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clerk publishable key — client-side by design, scoped by allowed origins.
VITE_CLERK_PUBLISHABLE_KEY=
